{
  "cli": {
    "version": "22.4.0",
    "appVersionSource": "local"
  },
  "build": {
    "internal": {
      "channel": "internal",
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote",
      "node": "22.14.0",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "autoIncrement": false
      }
    },
    "ios-simulator": {
      "extends": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "remote",
      "node": "22.14.0",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "autoIncrement": false
      }
    }
  }
}
