{
  "cli": {
    "version": "25.3.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "internal": {
      "channel": "internal",
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote",
      "node": "22.14.0",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "extends": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "remote",
      "node": "22.14.0",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "phone": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "wear": {
      "android": {
        "track": "wear:internal",
        "releaseStatus": "completed"
      }
    }
  }
}
