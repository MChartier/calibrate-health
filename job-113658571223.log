2026-10-09T03:41:36.3340693Z   script: const { VERSION: version, TAG: tag, BRANCH: branch } = process.env;
const owner = context.repo.owner;
const repo = context.repo.repo;
const releaseSha = process.env.RELEASE_SHA;
const { data: candidates } = await github.rest.pulls.list({
  owner,
  repo,
  head: owner + ':' + branch,
  base: 'master',
  state: 'all',
  per_page: 100,
});
const moved = candidates.find((pull) => pull.head.sha !== releaseSha && pull.state === 'open');
if (moved) {
  throw new Error('Release branch has open PR #' + moved.number + ' at unexpected ' + moved.head.sha + '.');
}
const existing = candidates.find((pull) => pull.head.sha === releaseSha && pull.state === 'open');
if (existing) {
  core.setOutput('pull_request_number', existing.number);
  core.setOutput('pull_request_url', existing.html_url);
  return;
}
const body = [
  '## Summary',
  '',
  `- synchronize the server and web release mirrors at ${version}`,
  `- prepare immutable source tag ${tag}`,
  '- leave Android phone and Wear release identities unchanged',
  '',
  '## Validation',
  '',
  '- exact candidate identity and synchronized release mirrors',
  '- production image build, readiness, and served-Web smoke',
  '- required CI must succeed on this exact candidate before merge; approval or missing checks block finalization',
  '',
  'Candidate metadata and production smoke passed. Cut release now waits for this PR’s CI; approve pending workflow runs if GitHub requests it. After CI and merge, image publication runs explicitly; OTA and deployment have separate readiness gates.',
].join('\n');
const { data: pull } = await github.rest.pulls.create({
  owner: context.repo.owner,
  repo: context.repo.repo,
  head: branch,
  base: 'master',
  title: `Release ${tag}`,
  body,
});
core.setOutput('pull_request_number', pull.number);
core.setOutput('pull_request_url', pull.html_url);

