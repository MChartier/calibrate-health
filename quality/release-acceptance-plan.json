{
  "schemaVersion": 3,
  "profile": "single-user-pre-release",
  "protocolPath": "docs/release-acceptance.md",
  "releaseManifestPath": "shared/release.json",
  "releaseNotesPath": "docs/releases/0.33.5-native-0.2.6-wear-0.2.6.md",
  "releaseScopes": [
    "server-web",
    "ota",
    "native"
  ],
  "policy": {
    "pullRequestChecks": "affected-only",
    "externalReleaseApproval": "owner-discretion",
    "retainedEvidenceRequired": false
  },
  "automaticRequirements": [
    {
      "id": "affected-builds",
      "title": "Compile and bundle only affected application surfaces",
      "releaseScopes": ["server-web", "ota", "native"],
      "trigger": "affected-pull-request",
      "workflowPaths": [".github/workflows/builds.yml"],
      "jobIds": [
        "release-config",
        "backend-build",
        "expo-web-build",
        "web-critical-smoke",
        "native-metro-bundle",
        "mobile-build",
        "wear-build"
      ]
    },
    {
      "id": "affected-tests-and-typecheck",
      "title": "Run unit tests and type checks for affected code",
      "releaseScopes": ["server-web", "ota", "native"],
      "trigger": "affected-pull-request",
      "workflowPaths": [
        ".github/workflows/tests.yml",
        ".github/workflows/lint.yml"
      ],
      "jobIds": ["backend-tests", "mobile-tests", "typecheck"]
    },
    {
      "id": "migration-safety",
      "title": "Exercise populated upgrades and rollback only when database migrations change",
      "releaseScopes": ["server-web"],
      "trigger": "migration-change",
      "workflowPaths": [".github/workflows/database-upgrade.yml"],
      "jobIds": ["populated-upgrade", "release-upgrade-rollback"]
    },
    {
      "id": "dependency-audit",
      "title": "Audit affected production dependencies",
      "releaseScopes": ["server-web", "ota", "native"],
      "trigger": "affected-pull-request-and-schedule",
      "workflowPaths": [".github/workflows/dependency-audit.yml"],
      "jobIds": ["production-audit"]
    },
    {
      "id": "production-container",
      "title": "Validate production containers for affected pull requests and releases",
      "releaseScopes": ["server-web"],
      "trigger": "affected-pull-request-and-release",
      "workflowPaths": [
        ".github/workflows/container-scan.yml",
        ".github/workflows/cut-release.yml"
      ],
      "jobIds": ["scan", "release-validation"]
    },
    {
      "id": "prepared-release-integrity",
      "title": "Publish the exact merged release, wait for deployment, then publish OTA",
      "releaseScopes": ["server-web", "ota"],
      "trigger": "release",
      "workflowPaths": [
        ".github/workflows/cut-release.yml",
        ".github/workflows/publish-release.yml",
        ".github/workflows/expo-ota-update.yml"
      ],
      "jobIds": [
        "prepare",
        "release-validation",
        "finalize",
        "publish",
        "tag_release",
        "build_release_image",
        "wait_for_hosted_release",
        "publish_ota",
        "publish-internal",
        "publish-production"
      ]
    }
  ],
  "manualCapabilities": [
    {
      "id": "owner-release-confidence",
      "title": "Optional owner-discretion release confidence check",
      "releaseScopes": ["server-web", "ota", "native"],
      "workflowPath": ".github/workflows/release-acceptance.yml",
      "jobIds": ["owner-confidence"]
    },
    {
      "id": "exhaustive-web-regression",
      "title": "Optional full browser, data-state, accessibility, and visual suites",
      "releaseScopes": ["server-web", "ota"],
      "workflowPath": ".github/workflows/builds.yml",
      "jobIds": ["exported-web-e2e", "data-state-acceptance", "ux-regression"]
    },
    {
      "id": "native-emulator-and-upgrade",
      "title": "Optional Android, Wear, and same-signer upgrade validation",
      "releaseScopes": ["native"],
      "workflowPath": ".github/workflows/builds.yml",
      "jobIds": [
        "android-emulator-e2e",
        "wear-release-emulator-smoke",
        "native-package-upgrade"
      ]
    }
  ]
}
