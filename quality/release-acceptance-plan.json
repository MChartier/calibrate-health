      "retainedArtifact": {
        "namePrefix": "launch-24-data-state-acceptance",
        "retentionDays": 90,
        "requiredResults": 1
      }
    },
    {
      "id": "hosted-android-emulator-e2e",
      "title": "Android online, offline, process-death, and replay E2E",
      "execution": "hosted",
      "blocksImplementation": true,
      "blocksExternalLaunch": true,
