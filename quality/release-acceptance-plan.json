{
  "schemaVersion": 1,
  "protocolPath": "docs/release-acceptance.md",
  "releaseManifestPath": "shared/release.json",
  "releaseNotesPath": "docs/releases/0.33.5-native-0.2.5-wear-0.2.5.md",
  "candidateContract": {
    "source": "pull-request-head",
    "shaFormat": "lowercase-40-hex",
    "checkoutExpression": "${{ github.event.pull_request.head.sha || github.sha }}"
  },
  "evidenceCommitContract": {
    "resultManifestPath": "quality/risk-evidence.json",
    "resultProperty": "releaseAcceptanceEvidence",
    "soleParentMustBeCandidate": true,
    "checkedOutHeadMustBeEvidence": true,
    "cleanWorktreeRequired": true,
    "allowlistedPathPatterns": [
      "quality/risk-evidence.json",
      "quality/physical-results/*.json"
    ]
  },
  "checkoutWorkflows": [
    ".github/workflows/builds.yml",
    ".github/workflows/tests.yml",
    ".github/workflows/lint.yml",
    ".github/workflows/database-upgrade.yml",
    ".github/workflows/dependency-audit.yml",
    ".github/workflows/container-scan.yml"
  ],
  "requirements": [
    {
      "id": "hosted-release-contracts",
      "title": "Frozen candidate and release contract validation",
      "execution": "hosted",
      "blocksImplementation": true,
      "blocksExternalLaunch": true,
      "workflowPath": ".github/workflows/release-acceptance.yml",
      "jobId": "implementation-contract",
      "command": "npm.cmd run release:acceptance",
      "retainedArtifact": {
        "namePrefix": "release-acceptance-contract-",
        "retentionDays": 90,
        "requiredResults": 1
      }
    },
    {
      "id": "hosted-exported-web-e2e",
      "title": "Full exported Web and PWA end-to-end suite",
      "execution": "hosted",
      "blocksImplementation": true,
      "blocksExternalLaunch": true,
      "workflowPath": ".github/workflows/builds.yml",
      "jobId": "exported-web-e2e",
      "command": "npm.cmd run test:expo-web",
      "retainedArtifact": {
        "namePrefix": "exported-web-e2e-",
        "retentionDays": 90,
        "requiredResults": 1
      }
    },
    {
      "id": "hosted-ux-regression",
      "title": "Accessibility and visual regression matrix",
      "execution": "hosted",
      "blocksImplementation": true,
      "blocksExternalLaunch": true,
      "workflowPath": ".github/workflows/builds.yml",
      "jobId": "ux-regression",
      "command": "npm.cmd run test:ux",
      "retainedArtifact": {
        "namePrefix": "ux-regression-summary-",
        "retentionDays": 90,
        "requiredResults": 1
      }
    },
    {
