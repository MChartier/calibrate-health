+  f.jobs.push({ ...f.jobs[0], id: 100, conclusion: 'failure' });
+  assert.throws(() => evaluateTrustedJobs(f.jobs, f.binding), /did not succeed/);
+  f.jobs[0].name = f.jobs[0].name.replace(identity.head, 'c'.repeat(40));
